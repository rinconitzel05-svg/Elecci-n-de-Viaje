/* ================================
   CONFIGURACIÓN GENERAL
================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #ffffff;
    color: #183b56;
    line-height: 1.6;
}

.container {
    width: 90%;
    max-width: 1100px;
    margin: auto;
}

.section {
    padding: 80px 0;
}

.section-light {
    background: #f2f8fb;
}

.section-tag {
    color: #0b8fac;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

h2 {
    font-size: 38px;
    margin-bottom: 20px;
    color: #12344d;
}

.section-text {
    max-width: 800px;
    margin-bottom: 18px;
    color: #536b7a;
}


/* ================================
   ENCABEZADO
================================ */

.hero {
    min-height: 650px;
    background:
        linear-gradient(
            rgba(9, 50, 72, 0.82),
            rgba(7, 108, 132, 0.78)
        ),
        linear-gradient(
            135deg,
            #0b5269,
            #38a3a5
        );

    color: white;
}


/* ================================
   NAVEGACIÓN
================================ */

.navbar {
    width: 90%;
    max-width: 1200px;
    margin: auto;
    padding: 25px 0;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 21px;
    font-weight: bold;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 22px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-size: 14px;
    font-weight: bold;
}

.nav-links a:hover {
    color: #a9e5f2;
}


/* ================================
   HERO
================================ */

.hero-content {
    width: 90%;
    max-width: 850px;
    margin: 120px auto 0;
}

.subtitle {
    font-size: 14px;
    letter-spacing: 3px;
    margin-bottom: 15px;
    color: #bcecf5;
    font-weight: bold;
}

.hero h1 {
    font-size: 58px;
    line-height: 1.1;
    margin-bottom: 25px;
}

.hero-content p {
    max-width: 650px;
    font-size: 18px;
    margin-bottom: 30px;
}


/* ================================
   BOTONES
================================ */

.btn {
    display: inline-block;
    padding: 14px 25px;

    background: #ffffff;
    color: #087e9d;

    border: none;
    border-radius: 8px;

    text-decoration: none;
    font-weight: bold;

    cursor: pointer;

    transition: 0.3s;
}

.btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
}

.btn-submit {
    width: 100%;
    background: #087e9d;
    color: white;
    margin-top: 10px;
}


/* ================================
   TARJETAS
================================ */

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin-top: 40px;
}

.card {
    background: white;
    padding: 30px;
    border-radius: 14px;

    box-shadow: 0 5px 20px rgba(20, 70, 90, 0.08);

    border: 1px solid #e1edf2;
}

.card-icon {
    display: block;
    font-size: 35px;
    margin-bottom: 15px;
}

.card h3 {
    margin-bottom: 10px;
    color: #12344d;
}

.card p {
    color: #627985;
}


/* ================================
   PASOS
================================ */

.steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 40px;
}

.step {
    background: white;
    padding: 25px;
    border-radius: 12px;
    border-left: 4px solid #0b8fac;
}

.step span {
    color: #0b8fac;
    font-weight: bold;
}

.step h3 {
    margin: 10px 0;
}

.step p {
    color: #627985;
    font-size: 14px;
}


/* ================================
   RESERVACIÓN
================================ */

.reservation-section {
    background: #ffffff;
}

.reservation-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 35px;

    margin-top: 40px;
}

.form-container,
.result-container {
    background: #f5fafc;
    padding: 35px;
    border-radius: 15px;

    border: 1px solid #dcecf1;
}

.form-group {
    margin-bottom: 20px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

label {
    display: block;
    margin-bottom: 7px;

    font-weight: bold;
    font-size: 14px;
    color: #183b56;
}

input,
select {
    width: 100%;
    padding: 13px;

    border: 1px solid #cbdde4;
    border-radius: 7px;

    background: white;

    font-size: 15px;
}

input:focus,
select:focus {
    outline: none;
    border-color: #0b8fac;
}

select:disabled {
    background: #e9f0f3;
    cursor: not-allowed;
}


/* ================================
   RESULTADO
================================ */

.result-container {
    min-height: 450px;
}

.result-placeholder {
    text-align: center;
    margin-top: 90px;
    color: #627985;
}

.result-icon {
    font-size: 55px;
}

.result-placeholder h3 {
    margin: 15px 0 10px;
    color: #183b56;
}

.result-title {
    font-size: 25px;
    color: #087e9d;
    margin-bottom: 20px;
}

.reservation-summary {
    background: white;
    padding: 20px;
    border-radius: 10px;
}

.summary-item {
    display: flex;
    justify-content: space-between;

    padding: 9px 0;

    border-bottom: 1px solid #e5eeee;
}

.summary-item span:first-child {
    color: #627985;
}

.summary-item span:last-child {
    font-weight: bold;
    color: #183b56;
}

.discount {
    color: #18864b !important;
}

.total {
    font-size: 21px;
    color: #087e9d !important;
}

.success-message {
    margin-top: 20px;
    padding: 15px;

    background: #e6f7ef;
    border-radius: 8px;

    color: #176b40;
    font-weight: bold;
    text-align: center;
}


/* ================================
   BENEFICIOS
================================ */

.benefits {
    margin-top: 45px;
    background: white;
    padding: 30px;
    border-radius: 14px;
}

.benefits h3 {
    margin-bottom: 15px;
}

.benefits ul {
    list-style: none;
}

.benefits li {
    margin: 8px 0;
    color: #526d7a;
}


/* ================================
   CRÉDITOS
================================ */

.credits {
    padding: 70px 0;
    background: #12344d;
    color: white;
}

.credits h2 {
    color: white;
}

.credits p {
    margin-bottom: 8px;
}

.credits .section-tag {
    color: #9fe3ef;
}

.credits-info {
    margin-top: 25px;
}


/* ================================
   PIE DE PÁGINA
================================ */

footer {
    background: #092638;
    color: #c9dbe2;
    text-align: center;

    padding: 20px;

    font-size: 13px;
}


/* ================================
   RESPONSIVE
================================ */

@media (max-width: 850px) {

    .navbar {
        flex-direction: column;
        gap: 20px;
    }

    .nav-links {
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero-content {
        margin-top: 80px;
    }

    .hero h1 {
        font-size: 42px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .steps {
        grid-template-columns: 1fr 1fr;
    }

    .reservation-layout {
        grid-template-columns: 1fr;
    }
}


@media (max-width: 550px) {

    .section {
        padding: 60px 0;
    }

    h2 {
        font-size: 30px;
    }

    .hero {
        min-height: 700px;
    }

    .hero h1 {
        font-size: 36px;
    }

    .hero-content p {
        font-size: 16px;
    }

    .steps {
        grid-template-columns: 1fr;
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    .form-container,
    .result-container {
        padding: 22px;
    }
}
